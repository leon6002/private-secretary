{
  "name": "private-secretary",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Personal Secretary relay — bridges Slack, Gmail, and WeChat. MVP runs inside Claude Code; relay/core is the pure, shared decision logic.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "relay": "tsx relay/cli.ts",
    "cockpit:build": "vite build relay/cockpit/web",
    "cockpit:dev": "vite relay/cockpit/web",
    "cockpit:typecheck": "tsc -p relay/cockpit/web --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "tailwind-merge": "^2.6.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.0"
  }
}
