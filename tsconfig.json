{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["relay/**/*.ts", "scripts/**/*.ts"],
  // The cockpit React app has its own tsconfig (relay/cockpit/web/tsconfig.json
  // — JSX, DOM lib, bundler resolution) checked by `npm run cockpit:typecheck`.
  // Excluded here so the Node-oriented settings above don't reject JSX.
  "exclude": ["relay/cockpit/web"]
}
