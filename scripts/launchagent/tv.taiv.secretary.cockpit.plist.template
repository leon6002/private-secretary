<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS LaunchAgent for the Taiv Secretary COCKPIT (the localhost triage UI).
  Renders into ~/Library/LaunchAgents/tv.taiv.secretary.cockpit.plist via
  scripts/launchagent/install.sh.

  Serves http://127.0.0.1:4317 (loopback-only, CSRF-guarded). REAL-SEND mode
  (wired executor): approve → Slack auto-sends, Gmail creates a real draft you
  send, WeChat is manual paste (no API), Calendar creates the event. Add
  <string>--dry-run</string> back to the args to make approve send nothing.

    tail -F @LOG_DIR@/cockpit.out.log
    launchctl unload ~/Library/LaunchAgents/tv.taiv.secretary.cockpit.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>tv.taiv.secretary.cockpit</string>

    <key>WorkingDirectory</key>
    <string>@REPO_ROOT@</string>

    <key>ProgramArguments</key>
    <array>
        <string>@NPX_PATH@</string>
        <string>tsx</string>
        <string>@REPO_ROOT@/scripts/run-cockpit.ts</string>
        <string>--port</string>
        <string>4317</string>
        <string>--no-open</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>@HOME@</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Always restart (see the daemon template): "only on failure" let a clean exit
         permanently un-manage the job, and the UI would silently stay down. -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>@LOG_DIR@/cockpit.out.log</string>

    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/cockpit.err.log</string>
</dict>
</plist>
