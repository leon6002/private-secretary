<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS LaunchAgent for the Taiv Secretary daemon. Renders into
  ~/Library/LaunchAgents/tv.taiv.secretary.plist via
  scripts/launchagent/install.sh (substitutes the @PLACEHOLDERS@).

  KeepAlive=true → launchd auto-restarts if the daemon crashes.
  RunAtLoad=true → starts on login.
  ProcessType=Background → eligible for the lid-close suspend behavior
    we want; we own catch-up via wall-clock-gap detection in the
    in-process Scheduler.
  StandardOut/ErrorPath → tail -F these to watch what the daemon is
    doing. The daemon also writes structured shadow-log records into
    state/shadow-log.jsonl, which is the canonical audit trail.

  Install:
    cp scripts/launchagent/tv.taiv.secretary.plist.template \
       ~/Library/LaunchAgents/tv.taiv.secretary.plist
    # sed-edit @REPO_ROOT@ + @NPX_PATH@ + @LOG_DIR@ inside that file
    launchctl load ~/Library/LaunchAgents/tv.taiv.secretary.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/tv.taiv.secretary.plist
    rm ~/Library/LaunchAgents/tv.taiv.secretary.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>tv.taiv.secretary</string>

    <key>WorkingDirectory</key>
    <string>@REPO_ROOT@</string>

    <key>ProgramArguments</key>
    <array>
        <string>@NPX_PATH@</string>
        <string>tsx</string>
        <string>@REPO_ROOT@/scripts/run-notify.ts</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>@HOME@</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Always restart. It used to be {SuccessfulExit:false}, which means "only
         restart on failure" — but run-notify's single-instance guard exits 0 when
         another instance holds the lock, and that clean exit made launchd stop
         managing the job entirely: once the real daemon later died, nothing brought
         it back. The PID-lock (state/run-notify.pid, verified against the process's
         command so a reused PID can't block startup) is what prevents duplicates. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Don't let a spawn failure hot-loop (it once retried 56k times). -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>@LOG_DIR@/secretary.out.log</string>

    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/secretary.err.log</string>
</dict>
</plist>
