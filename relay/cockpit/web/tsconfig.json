{
  // The React app's own tsconfig. The ROOT tsconfig excludes relay/cockpit/web
  // (its Node-oriented settings — no JSX, node/vitest types — would reject
  // this code); `npm run cockpit:typecheck` checks the app with this file.
  // Project references were considered and rejected: one extra config with an
  // exclude in the root is simpler and keeps `npm run typecheck` a single pass.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
